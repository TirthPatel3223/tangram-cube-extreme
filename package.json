{
  "name": "tangram-cube-extreme",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive 3D simulator of the DaYan Tangram Cube Extreme (and the original Tangram Cube): exact cut geometry, 60-degree corner turns, edge flips and shape-shifting.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
